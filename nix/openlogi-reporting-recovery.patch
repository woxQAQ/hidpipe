+            let reporting = rc.get_cid_reporting(cid).await?;
+            if !reporting.diverted || reporting.raw_xy != raw_xy {
+                warn!(
+                    cid,
+                    diverted = reporting.diverted,
+                    raw_xy = reporting.raw_xy,
+                    expected_raw_xy = raw_xy,
+                    "device control reporting differs from capture plan"
+                );
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
