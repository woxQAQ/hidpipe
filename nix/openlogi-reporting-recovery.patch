 impl ArmedControls {
+    /// Check that the firmware still reports the controls this session owns.
+    async fn reporting_matches(&self) -> Result<bool, v20::Hidpp20Error> {
+        let Some((rc, _)) = self.reprog.as_ref() else {
+            return Ok(true);
