index 00000000..bfeb2ef0
--- /dev/null
+++ b/crates/openlogi-agent-core/src/remote.rs
@@ -0,0 +1,500 @@
+//! Opt-in local pointer routing for hidpipe. The GUI IPC remains independent.
+//!
+//! One capture lease routes the configured Linux mouse before binding lookup.
+//! An input-resolution connection uses this machine's profile and app context.
+//! The socket must live in a private user directory; no network listener exists.
+
+mod engine;
+/// Fixed-size bridge records shared with hidpipe.
+pub mod wire;
+
+use std::io::{self, Read, Write};
+use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
+use std::os::unix::net::{UnixListener, UnixStream};
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+use std::sync::mpsc::{self, SyncSender};
+use std::sync::{Arc, Mutex, OnceLock, RwLock};
+use std::thread;
+use std::time::Duration;
+
+use openlogi_core::config::Config;
+use openlogi_hid::gesture::CapturedInput;
+use openlogi_hook::{EventDisposition, MouseEvent};
+use tracing::warn;
+
+use crate::orchestrator::SharedRuntime;
+use engine::{Effect, Engine, Profile, button_number};
+use wire::{MAGIC, PointerEvent};
+
+static BRIDGE: OnceLock<Arc<Bridge>> = OnceLock::new();
+const TIMEOUT: Duration = Duration::from_millis(750);
+
+struct Lease {
+    events: SyncSender<PointerEvent>,
+    alive: Arc<AtomicBool>,
+}
+
+#[derive(Default)]
+struct Routing {
+    lease: Option<Lease>,
+}
+
+/// Explicit bridge configuration. Socket activation is disabled by default.
+pub struct Options {
+    /// Socket in a directory owned by the current user, with mode 0700.
+    pub socket: PathBuf,
+    /// This machine's per-device config key, independent of the peer's key.
+    pub device: String,
+}
+
+/// Bridge state, owned for the lifetime of the agent.
+pub struct Bridge {
+    options: Options,
+    profile: RwLock<Profile>,
+    key: RwLock<String>,
+    hook_ready: AtomicBool,
+    hid_ready: AtomicBool,
+    capture_active: AtomicBool,
+    capture_fault: AtomicBool,
+    down: AtomicU8,
+    quarantine: AtomicU8,
+    routing: Mutex<Routing>,
+    local_engine: Mutex<Engine>,
+    effects: SyncSender<Effect>,
+    receiver: Mutex<Option<mpsc::Receiver<Effect>>>,
+}
+
+/// Install an explicit bridge. Capture and resolution remain separate leases.
+pub fn install(options: Options, config: &Config) -> io::Result<Arc<Bridge>> {
+    let (effects, receiver) = mpsc::sync_channel(256);
+    let bridge = Arc::new(Bridge {
+        profile: RwLock::new(Profile::new(config, &options.device, None)),
+        key: RwLock::new(options.device.clone()),
+        hook_ready: AtomicBool::new(false),
+        hid_ready: AtomicBool::new(false),
+        capture_active: AtomicBool::new(false),
+        capture_fault: AtomicBool::new(false),
+        down: AtomicU8::new(0),
+        quarantine: AtomicU8::new(0),
+        options,
+        routing: Mutex::new(Routing::default()),
+        local_engine: Mutex::new(Engine::default()),
+        effects,
+        receiver: Mutex::new(Some(receiver)),
+    });
+    BRIDGE
+        .set(Arc::clone(&bridge))
+        .map_err(|_| io::Error::other("pointer bridge already installed"))?;
+    Ok(bridge)
+}
+
+/// Read opt-in configuration. A Mac may reuse its already selected device key.
+pub fn install_from_env(config: &Config) -> io::Result<Option<Arc<Bridge>>> {
+    let Some(socket) = std::env::var_os("OPENLOGI_BRIDGE_SOCKET") else {
+        return Ok(None);
+    };
+    let device = std::env::var("OPENLOGI_BRIDGE_DEVICE")
+        .ok()
+        .or_else(|| {
+            if cfg!(target_os = "macos") {
+                config.selected_device().map(str::to_owned)
+            } else {
+                None
+            }
+        })
+        .unwrap_or_else(|| "auto".to_owned());
+    install(
+        Options {
+            socket: socket.into(),
+            device,
+        },
+        config,
+    )
+    .map(Some)
+}
+
+/// Whether this device needs capture independent of its local bindings.
+#[must_use]
+pub fn enabled_for(key: &str) -> bool {
+    cfg!(target_os = "linux")
+        && BRIDGE
+            .get()
+            .is_some_and(|bridge| bridge.key.read().is_ok_and(|current| *current == key))
+}
+
+/// Publish the configured device's profile using this machine's app context.
+pub fn publish(config: &Config, app: Option<&str>, fallback: Option<&str>) {
+    if let Some(bridge) = BRIDGE.get()
+        && let (Ok(mut profile), Ok(mut key)) = (bridge.profile.write(), bridge.key.write())
+    {
+        let selected = if bridge.options.device == "auto" {
+            fallback.or(config.selected_device()).unwrap_or("auto")
+        } else {
+            &bridge.options.device
+        };
+        if *key != selected {
+            bridge.hid_ready.store(false, Ordering::Release);
+            bridge.capture_fault.store(true, Ordering::Release);
+            selected.clone_into(&mut key);
+        }
+        *profile = Profile::new(config, &key, app);
+    }
+}
+
+/// Publish native-hook readiness; a failed hook must not acquire a capture lease.
+pub fn hook_ready(ready: bool) {
+    if let Some(bridge) = BRIDGE.get() {
+        bridge.hook_ready.store(ready, Ordering::Release);
+        if !ready {
+            bridge.capture_fault.store(true, Ordering::Release);
+        }
+    }
+}
+
+impl Bridge {
+    /// Bind the private local socket and start the action and connection workers.
+    pub fn serve(self: &Arc<Self>, shared: SharedRuntime) -> io::Result<()> {
+        let parent = self
+            .options
+            .socket
+            .parent()
+            .ok_or_else(|| io::Error::other("socket needs a private directory"))?;
+        std::fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(parent)?;
+        let parent_meta = std::fs::symlink_metadata(parent)?;
+        if !parent_meta.is_dir() || parent_meta.permissions().mode() & 0o077 != 0 {
+            return Err(io::Error::other(
+                "bridge socket directory must have mode 0700",
+            ));
+        }
+        if self.options.socket.exists() {
+            if UnixStream::connect(&self.options.socket).is_ok() {
+                return Err(io::ErrorKind::AddrInUse.into());
+            }
+            std::fs::remove_file(&self.options.socket)?;
+        }
+        let listener = UnixListener::bind(&self.options.socket)?;
+        std::fs::set_permissions(&self.options.socket, std::fs::Permissions::from_mode(0o600))?;
+        let receiver = self
+            .receiver
+            .lock()
+            .map_err(|_| io::Error::other("bridge poisoned"))?
+            .take()
+            .ok_or_else(|| io::Error::other("bridge already serving"))?;
+        let owner = Arc::clone(self);
+        thread::spawn(move || {
+            while let Ok(effect) = receiver.recv() {
+                let key = owner
+                    .key
+                    .read()
+                    .map_or_else(|_| owner.options.device.clone(), |key| key.clone());
+                match effect {
+                    Effect::Action(action) => crate::hook_runtime::dispatch_action(
+                        &action,
+                        &shared.dpi_cycle,
+                        Some(&key),
+                        &shared.capture_channel,
+                        Some(&shared.channel_registry),
+                        &shared.receiver_access,
+                    ),
+                    Effect::Scroll(lines) => openlogi_inject::post_horizontal_scroll(lines),
+                }
+            }
+        });
+        let bridge = Arc::clone(self);
+        thread::spawn(move || {
+            for stream in listener.incoming() {
+                match stream {
+                    Ok(stream) => {
+                        let bridge = Arc::clone(&bridge);
+                        thread::spawn(move || {
+                            if let Err(error) = bridge.connection(stream) {
+                                tracing::debug!(%error, "pointer bridge connection ended");
+                            }
+                        });
+                    }
+                    Err(error) => warn!(%error, "pointer bridge accept failed"),
+                }
+            }
+        });
+        Ok(())
+    }
+
+    fn connection(self: &Arc<Self>, mut stream: UnixStream) -> io::Result<()> {
+        stream.set_read_timeout(Some(TIMEOUT))?;
+        stream.set_write_timeout(Some(TIMEOUT))?;
+        let mut hello = [0; 6];
+        stream.read_exact(&mut hello)?;
+        if hello[..5] != MAGIC {
+            return Err(io::ErrorKind::InvalidData.into());
+        }
+        match hello[5] {
+            0 if cfg!(target_os = "linux") => self.capture_connection(stream),
+            1 if openlogi_hook::Hook::has_accessibility() => self.resolve_connection(stream),
+            _ => Err(io::ErrorKind::InvalidData.into()),
+        }
+    }
+
+    fn capture_connection(self: &Arc<Self>, mut stream: UnixStream) -> io::Result<()> {
+        let (events, receiver) = mpsc::sync_channel(1024);
+        if !self.hook_ready.load(Ordering::Acquire) || !self.hid_ready.load(Ordering::Acquire) {
+            stream.write_all(&[1])?;
+            return Err(io::Error::other(
+                "pointer hook or HID++ capture is not ready",
+            ));
+        }
+        let alive = Arc::new(AtomicBool::new(true));
+        {
+            let mut routing = self
+                .routing
+                .lock()
+                .map_err(|_| io::Error::other("bridge poisoned"))?;
+            if routing.lease.is_some() {
+                drop(routing);
+                stream.write_all(&[1])?;
+                return Err(io::Error::other("mouse is already leased"));
+            }
+            // Publish capture intent before testing held buttons. A concurrent
+            // callback either makes the admission check fail, or suppresses the
+            // event and faults this lease; it cannot deliver half a local click.
+            self.capture_fault.store(false, Ordering::Release);
+            self.capture_active.store(true, Ordering::SeqCst);
+            if self.down.load(Ordering::SeqCst) != 0 {
+                self.capture_active.store(false, Ordering::SeqCst);
+                drop(routing);
+                stream.write_all(&[1])?;
+                return Err(io::Error::other("mouse is held"));
+            }
+            routing.lease = Some(Lease {
+                events,
+                alive: Arc::clone(&alive),
+            });
+        }
+        let guard = CaptureGuard {
+            bridge: Arc::clone(self),
+            alive: Arc::clone(&alive),
+        };
+        // ACK is ordered before captured input. Dropping the guard handles all
+        // failure paths, including a partial handshake or a stalled writer.
+        stream.write_all(&[0])?;
+        let mut writer = stream.try_clone()?;
+        let writer_alive = Arc::clone(&alive);
+        let bridge = Arc::clone(self);
+        thread::spawn(move || {
+            while writer_alive.load(Ordering::Acquire)
+                && !bridge.capture_fault.load(Ordering::Acquire)
+            {
+                match receiver.recv_timeout(Duration::from_millis(20)) {
+                    Ok(event) => {
+                        if event.write(&mut writer).is_err() {
+                            break;
+                        }
+                    }
+                    Err(mpsc::RecvTimeoutError::Timeout) => {}
+                    Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                }
+            }
+            writer_alive.store(false, Ordering::Release);
+            let _ = writer.shutdown(std::net::Shutdown::Both);
+        });
+        while alive.load(Ordering::Acquire) {
+            let mut heartbeat = [0];
+            if stream.read_exact(&mut heartbeat).is_err() || heartbeat != [0] {
+                break;
+            }
+        }
+        drop(guard);
+        Ok(())
+    }
+
+    fn resolve_connection(&self, mut stream: UnixStream) -> io::Result<()> {
+        // Idle is normal on the destination. A partial record is bounded by
+        // hidpipe's write deadline; EOF drops all resolver state without actions.
+        stream.set_read_timeout(None)?;
+        stream.write_all(&[0])?;
+        let mut engine = Engine::default();
+        loop {
+            let event = PointerEvent::read(&mut stream)?;
+            let profile = self
+                .profile
+                .read()
+                .map_err(|_| io::Error::other("profile poisoned"))?;
+            let result = engine.process(event, &profile);
+            drop(profile);
+            for effect in result.effects {
+                self.effects
+                    .try_send(effect)
+                    .map_err(|_| io::Error::other("action queue unavailable"))?;
+            }
+            stream.write_all(&[u8::from(!result.pass)])?;
+        }
+    }
+
+    fn route(&self, event: PointerEvent) -> bool {
+        let mut quarantined = false;
+        if let PointerEvent::Button { button, pressed } = event {
+            let mask = 1u8 << button;
+            quarantined = self.quarantine.load(Ordering::Acquire) & mask != 0;
+            if pressed {
+                self.down.fetch_or(mask, Ordering::SeqCst);
+            } else {
+                self.down.fetch_and(!mask, Ordering::SeqCst);
+                self.quarantine.fetch_and(!mask, Ordering::AcqRel);
+            }
+        }
+        let Ok(routing) = self.routing.try_lock() else {
+            let active = self.capture_active.load(Ordering::SeqCst);
+            if active {
+                self.capture_fault.store(true, Ordering::Release);
+            }
+            return active;
+        };
+        if let Some(lease) = routing.lease.as_ref() {
+            if lease.alive.load(Ordering::Acquire) && lease.events.try_send(event).is_ok() {
+                return true;
+            }
+            lease.alive.store(false, Ordering::Release);
+            self.quarantine
+                .store(self.down.load(Ordering::Acquire), Ordering::Release);
+            // The current event still belongs to the failed remote session.
+            return true;
+        }
+        quarantined
+            || matches!(event, PointerEvent::GestureMotion { .. })
+                && self.quarantine.load(Ordering::Acquire) & (1 << 5) != 0
+    }
+
+    fn local(&self, event: PointerEvent) {
+        // This runs on the HID++ worker, outside the OS input hook. Preserve
+        // every control transition across profile publication; dropping a
+        // release would leave the engine ignoring subsequent presses.
+        let (Ok(mut engine), Ok(profile)) = (self.local_engine.lock(), self.profile.read()) else {
+            return;
+        };
+        for effect in engine.process(event, &profile).effects {
+            if self.effects.try_send(effect).is_err() {
+                warn!("pointer action queue unavailable");
+            }
+        }
+    }
+}
+
+struct CaptureGuard {
+    bridge: Arc<Bridge>,
+    alive: Arc<AtomicBool>,
+}
+
+impl Drop for CaptureGuard {
+    fn drop(&mut self) {
+        self.alive.store(false, Ordering::Release);
+        self.bridge.capture_active.store(false, Ordering::Release);
+        if let Ok(mut routing) = self.bridge.routing.lock() {
+            self.bridge
+                .quarantine
+                .store(self.bridge.down.load(Ordering::Acquire), Ordering::Release);
+            routing.lease = None;
+        }
+        if let Ok(mut engine) = self.bridge.local_engine.lock() {
+            *engine = Engine::default();
+        }
+    }
+}
+
+/// Intercept Linux OS-hook input before applying Linux bindings.
+#[must_use]
+pub fn hook_input(event: &MouseEvent) -> Option<EventDisposition> {
+    if !cfg!(target_os = "linux") {
+        return None;
+    }
+    let bridge = BRIDGE.get()?;
+    if matches!(event, MouseEvent::CaptureInterrupted) {
+        bridge.hook_ready.store(false, Ordering::Release);
+        bridge.capture_fault.store(true, Ordering::Release);
+    }
+    let event = match event {
+        MouseEvent::Button { id, pressed, .. } => PointerEvent::Button {
+            button: button_number(*id)?,
+            pressed: *pressed,
+        },
+        MouseEvent::Moved { delta_x, delta_y } => PointerEvent::Motion {
+            dx: *delta_x,
+            dy: *delta_y,
+        },
+        MouseEvent::Scroll {
+            delta_x, delta_y, ..
+        } => PointerEvent::Wheel {
+            dx: wheel_units(*delta_x),
+            dy: wheel_units(*delta_y),
+        },
+        MouseEvent::CaptureInterrupted => PointerEvent::Reset,
+    };
+    bridge.route(event).then_some(EventDisposition::Suppress)
+}
+
+#[expect(
+    clippy::cast_possible_truncation,
+    reason = "rounded, saturating conversion to wire wheel units"
+)]
+fn wheel_units(delta: f32) -> i32 {
+    (delta * 120.0).round() as i32
+}
+
+/// Handle selected-device HID++ controls before any Linux binding is resolved.
+#[must_use]
+pub fn captured(key: &str, input: CapturedInput) -> bool {
+    if !cfg!(target_os = "linux") || !enabled_for(key) {
+        return false;
+    }
+    let Some(bridge) = BRIDGE.get() else {
+        return false;
+    };
+    let event = match input {
+        CapturedInput::Ready => {
+            bridge.hid_ready.store(true, Ordering::Release);
+            None
+        }
+        CapturedInput::Interrupted => {
+            bridge.hid_ready.store(false, Ordering::Release);
+            bridge.capture_fault.store(true, Ordering::Release);
+            // A stopped HID++ session cannot deliver releases for its controls.
+            // Native buttons remain tracked by the independent OS hook.
+            bridge.down.fetch_and(0b0001_1111, Ordering::SeqCst);
+            bridge.quarantine.fetch_and(0b0001_1111, Ordering::AcqRel);
+            bridge.local(PointerEvent::Reset);
+            None
+        }
+        CapturedInput::RawButton { button, pressed } => {
+            button_number(button).map(|button| PointerEvent::Button { button, pressed })
+        }
+        CapturedInput::RawMotion { dx, dy } => Some(PointerEvent::GestureMotion {
+            dx: i32::from(dx),
+            dy: i32::from(dy),
+        }),
+        CapturedInput::Scroll(delta) => Some(PointerEvent::ThumbWheel(i32::from(delta))),
+        CapturedInput::ButtonPressed(openlogi_core::binding::ButtonId::Thumbwheel, _) => {
+            for pressed in [true, false] {
+                let event = PointerEvent::Button { button: 7, pressed };
+                if !bridge.route(event) {
+                    bridge.local(event);
+                }
+            }
+            None
+        }
+        _ => None,
+    };
+    if let Some(event) = event
+        && !bridge.route(event)
+    {
+        bridge.local(event);
+    }
+    true
+}
+
+/// Socket location for diagnostics.
+#[must_use]
+pub fn socket_path() -> Option<&'static Path> {
+    BRIDGE.get().map(|bridge| bridge.options.socket.as_path())
+}
