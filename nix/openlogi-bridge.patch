+//! Binding resolution for an explicitly connected remote pointer.
+
+use std::collections::{BTreeMap, HashMap};
+use std::time::Instant;
+
+use openlogi_core::binding::{Action, ButtonId, GestureDirection, SwipeAccumulator};
+use openlogi_core::config::Config;
+
+use super::wire::PointerEvent;
+use crate::bindings::{bindings_for, gesture_bindings_for, oshook_gestures_for};
+use crate::watchers::gesture::{WheelAccumulators, WheelOutput, advance};
+
+pub(super) struct Profile {
+    bindings: BTreeMap<ButtonId, Action>,
+    gestures: BTreeMap<ButtonId, BTreeMap<GestureDirection, Action>>,
+    sensitivity: i32,
+}
+
+impl Profile {
+    pub(super) fn new(config: &Config, key: &str, app: Option<&str>) -> Self {
+        let mut gestures = oshook_gestures_for(config, Some(key), app);
+        let dedicated = gesture_bindings_for(config, Some(key));
+        if !dedicated.is_empty() {
+            gestures.insert(ButtonId::GestureButton, dedicated);
+        }
+        Self {
+            bindings: bindings_for(config, Some(key), app),
+            gestures,
+            sensitivity: config.thumbwheel_sensitivity(key),
+        }
+    }
+}
+
+pub(super) enum Effect {
+    Action(Action),
+    Scroll(i32),
+}
+
+#[derive(Default)]
+pub(super) struct Resolution {
+    pub pass: bool,
+    pub effects: Vec<Effect>,
+}
+
+struct Press {
+    pass: bool,
+    gesture: Option<(SwipeAccumulator, BTreeMap<GestureDirection, Action>)>,
+}
+
+#[derive(Default)]
+pub(super) struct Engine {
+    presses: HashMap<u8, Press>,
+    wheel: WheelAccumulators,
+}
+
+impl Engine {
+    pub(super) fn process(&mut self, event: PointerEvent, profile: &Profile) -> Resolution {
+        let mut result = Resolution::default();
+        match event {
+            PointerEvent::Reset => *self = Self::default(),
+            PointerEvent::Button { button, pressed } => {
+                if pressed {
+                    if self.presses.contains_key(&button) {
+                        return result;
+                    }
+                    let Some(id) = button_id(button) else {
+                        return result;
+                    };
+                    let gesture = profile.gestures.get(&id).map(|map| {
+                        let mut swipe = SwipeAccumulator::default();
+                        swipe.begin();
+                        (swipe, map.clone())
+                    });
+                    let action = profile.bindings.get(&id).cloned().unwrap_or(Action::None);
+                    let pass = gesture.is_none()
+                        && matches!(
+                            (id, &action),
+                            (ButtonId::LeftClick, Action::LeftClick)
+                                | (ButtonId::RightClick, Action::RightClick)
+                                | (ButtonId::MiddleClick, Action::MiddleClick)
+                        );
+                    if !pass && gesture.is_none() {
+                        result.effects.push(Effect::Action(action));
+                    }
+                    self.presses.insert(button, Press { pass, gesture });
+                    result.pass = pass;
+                } else if let Some(mut press) = self.presses.remove(&button) {
+                    result.pass = press.pass;
+                    if let Some((swipe, map)) = press.gesture.as_mut()
+                        && swipe.end()
+                        && let Some(action) = map.get(&GestureDirection::Click)
+                    {
+                        result.effects.push(Effect::Action(action.clone()));
+                    }
+                }
+            }
+            PointerEvent::Motion { dx, dy } | PointerEvent::GestureMotion { dx, dy } => {
+                let dedicated = matches!(event, PointerEvent::GestureMotion { .. });
+                result.pass = !dedicated;
+                for (&button, press) in &mut self.presses {
+                    if (button == 5) != dedicated {
+                        continue;
+                    }
+                    if let Some((swipe, map)) = press.gesture.as_mut() {
+                        result.pass = false;
+                        if let Some(direction) = swipe.accumulate(dx, dy)
+                            && let Some(action) = map.get(&direction)
+                        {
+                            result.effects.push(Effect::Action(action.clone()));
+                        }
+                    }
+                }
+            }
+            PointerEvent::Wheel { .. } => result.pass = true,
+            PointerEvent::ThumbWheel(delta) => {
+                let (direction, button) = if delta >= 0 {
+                    (&mut self.wheel.up, ButtonId::ThumbwheelScrollUp)
+                } else {
+                    (&mut self.wheel.down, ButtonId::ThumbwheelScrollDown)
+                };
+                if let Some(action) = profile.bindings.get(&button) {
+                    match advance(
+                        direction,
+                        action,
+                        delta.saturating_abs(),
+                        profile.sensitivity,
+                        Instant::now(),
+                    ) {
+                        WheelOutput::Idle => {}
+                        WheelOutput::Scroll(lines) => result.effects.push(Effect::Scroll(lines)),
+                        WheelOutput::FireAction => {
+                            result.effects.push(Effect::Action(action.clone()));
+                        }
+                    }
+                }
+            }
+        }
+        result
+    }
+}
+
+pub(super) fn button_id(button: u8) -> Option<ButtonId> {
+    Some(match button {
+        0 => ButtonId::LeftClick,
+        1 => ButtonId::RightClick,
+        2 => ButtonId::MiddleClick,
+        3 => ButtonId::Back,
+        4 => ButtonId::Forward,
+        5 => ButtonId::GestureButton,
+        6 => ButtonId::DpiToggle,
+        7 => ButtonId::Thumbwheel,
+        _ => return None,
+    })
+}
+
+pub(super) fn button_number(button: ButtonId) -> Option<u8> {
+    (0..=7).find(|&number| button_id(number) == Some(button))
+}
