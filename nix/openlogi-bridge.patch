diff --git a/crates/openlogi-agent-core/tests/remote_bridge.rs b/crates/openlogi-agent-core/tests/remote_bridge.rs
new file mode 100644
index 00000000..010ba97a
--- /dev/null
+++ b/crates/openlogi-agent-core/tests/remote_bridge.rs
@@ -0,0 +1,257 @@
+//! Exercise both roles of the actual agent without opening input devices or
+//! injecting platform actions. The singleton bridge uses one integration test.
+#![cfg(target_os = "linux")]
+#![expect(clippy::unwrap_used, reason = "integration test assertions")]
+
+use std::io::{Read, Write};
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::net::UnixStream;
+use std::path::Path;
+use std::time::{Duration, Instant};
+
+use openlogi_agent_core::{orchestrator::Orchestrator, remote};
+use openlogi_core::binding::{Action, ButtonId};
+use openlogi_core::config::Config;
+use openlogi_hid::gesture::CapturedInput;
+use openlogi_hook::{EventDisposition, MouseEvent};
+use remote::wire::{MAGIC, PointerEvent};
+
+fn connect(path: &Path, role: u8) -> (UnixStream, u8) {
+    let mut stream = UnixStream::connect(path).unwrap();
+    stream
+        .set_read_timeout(Some(Duration::from_secs(2)))
+        .unwrap();
+    stream.write_all(&MAGIC).unwrap();
+    stream.write_all(&[role]).unwrap();
+    let mut ack = [0];
+    stream.read_exact(&mut ack).unwrap();
+    (stream, ack[0])
+}
+
+fn resolve(stream: &mut UnixStream, event: PointerEvent) -> u8 {
+    event.write(stream).unwrap();
+    let mut ack = [0];
+    stream.read_exact(&mut ack).unwrap();
+    ack[0]
+}
+
+fn destination_profile(socket: &Path, config: &mut Config) {
+    let (mut resolver, ack) = connect(socket, 1);
+    assert_eq!(ack, 0);
+    let down = PointerEvent::Button {
+        button: 2,
+        pressed: true,
+    };
+    let up = PointerEvent::Button {
+        button: 2,
+        pressed: false,
+    };
+    assert_eq!(
+        resolve(&mut resolver, down),
+        1,
+        "destination binding consumes the press"
+    );
+    config.set_binding("mouse", ButtonId::MiddleClick, Action::MiddleClick.into());
+    remote::publish(config, None, None);
+    assert_eq!(
+        resolve(&mut resolver, up),
+        1,
+        "a reload cannot change a held press's disposition"
+    );
+    assert_eq!(
+        resolve(&mut resolver, down),
+        0,
+        "next press sees the updated profile"
+    );
+    assert_eq!(resolve(&mut resolver, PointerEvent::Reset), 1);
+    assert_eq!(
+        resolve(&mut resolver, up),
+        1,
+        "reset forgets the cancelled hold"
+    );
+    assert_eq!(
+        resolve(&mut resolver, PointerEvent::Wheel { dx: 1, dy: -1 }),
+        0,
+        "hi-res units survive binding resolution"
+    );
+}
+
+#[cfg(target_os = "linux")]
+fn capture_records(socket: &Path) -> UnixStream {
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(
+        ack, 1,
+        "capture refuses before the native hook and HID++ are ready"
+    );
+    remote::hook_ready(true);
+    assert!(remote::captured("mouse", CapturedInput::Ready));
+    let native_down = MouseEvent::Button {
+        id: ButtonId::LeftClick,
+        pressed: true,
+        device: None,
+    };
+    let native_up = MouseEvent::Button {
+        id: ButtonId::LeftClick,
+        pressed: false,
+        device: None,
+    };
+    assert!(remote::hook_input(&native_down).is_none());
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(
+        ack, 1,
+        "a locally held button prevents splitting its press and release"
+    );
+    assert!(remote::hook_input(&native_up).is_none());
+    let (mut capture, ack) = connect(socket, 0);
+    assert_eq!(ack, 0);
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(ack, 1, "one owner per mouse");
+    let motion = MouseEvent::Moved {
+        delta_x: 17,
+        delta_y: -3,
+    };
+    assert!(matches!(
+        remote::hook_input(&motion),
+        Some(EventDisposition::Suppress)
+    ));
+    assert_eq!(
+        PointerEvent::read(&mut capture).unwrap(),
+        PointerEvent::Motion { dx: 17, dy: -3 }
+    );
+    assert!(remote::captured(
+        "mouse",
+        CapturedInput::RawButton {
+            button: ButtonId::GestureButton,
+            pressed: true
+        }
+    ));
+    assert_eq!(
+        PointerEvent::read(&mut capture).unwrap(),
+        PointerEvent::Button {
+            button: 5,
+            pressed: true
+        }
+    );
+    assert!(remote::captured(
+        "mouse",
+        CapturedInput::RawMotion { dx: 19, dy: -23 }
+    ));
+    assert_eq!(
+        PointerEvent::read(&mut capture).unwrap(),
+        PointerEvent::GestureMotion { dx: 19, dy: -23 }
+    );
+    capture
+}
+
+#[cfg(target_os = "linux")]
+fn capture_recovery(socket: &Path, capture: UnixStream) {
+    drop(capture);
+    let motion = MouseEvent::Moved {
+        delta_x: 1,
+        delta_y: 0,
+    };
+    let deadline = Instant::now() + Duration::from_secs(2);
+    // EOF is observed independently of the input callback threads.
+    while matches!(
+        remote::hook_input(&motion),
+        Some(EventDisposition::Suppress)
+    ) {
+        assert!(Instant::now() < deadline, "EOF must restore local routing");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(
+        ack, 1,
+        "the remote-held gesture control has not been released yet"
+    );
+    assert!(remote::captured(
+        "mouse",
+        CapturedInput::RawButton {
+            button: ButtonId::GestureButton,
+            pressed: false
+        }
+    ));
+    let (capture, ack) = connect(socket, 0);
+    assert_eq!(ack, 0);
+    while matches!(
+        remote::hook_input(&motion),
+        Some(EventDisposition::Suppress)
+    ) {
+        assert!(
+            Instant::now() < deadline,
+            "a stalled client must lose its capture lease"
+        );
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    drop(capture);
+}
+
+fn interrupted_controls_recover(socket: &Path) {
+    let motion = MouseEvent::Moved {
+        delta_x: 1,
+        delta_y: 0,
+    };
+    let deadline = Instant::now() + Duration::from_secs(2);
+    while remote::hook_input(&motion).is_some() {
+        assert!(Instant::now() < deadline, "capture cleanup must finish");
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    assert!(
+        remote::hook_input(&MouseEvent::Button {
+            id: ButtonId::LeftClick,
+            pressed: true,
+            device: None,
+        })
+        .is_none()
+    );
+    assert!(remote::captured(
+        "mouse",
+        CapturedInput::RawButton {
+            button: ButtonId::GestureButton,
+            pressed: true,
+        },
+    ));
+    assert!(remote::captured("mouse", CapturedInput::Interrupted));
+    assert!(remote::captured("mouse", CapturedInput::Ready));
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(ack, 1, "HID++ interruption must retain native button holds");
+    assert!(
+        remote::hook_input(&MouseEvent::Button {
+            id: ButtonId::LeftClick,
+            pressed: false,
+            device: None,
+        })
+        .is_none()
+    );
+    let (_capture, ack) = connect(socket, 0);
+    assert_eq!(
+        ack, 0,
+        "re-armed HID++ controls must forget interrupted holds"
+    );
+}
+
+#[test]
+fn local_socket_routes_before_bindings_and_cleans_up_leases() {
+    let directory =
+        std::env::temp_dir().join(format!("openlogi-bridge-test-{}", std::process::id()));
+    std::fs::create_dir(&directory).unwrap();
+    std::fs::set_permissions(&directory, std::fs::Permissions::from_mode(0o700)).unwrap();
+    let socket = directory.join("pointer.sock");
+    let mut config = Config::default();
+    config.set_binding("mouse", ButtonId::MiddleClick, Action::None.into());
+    let bridge = remote::install(
+        remote::Options {
+            socket: socket.clone(),
+            device: "mouse".into(),
+        },
+        &config,
+    )
+    .unwrap();
+    let orchestrator = Orchestrator::new(config.clone());
+    bridge.serve(orchestrator.shared()).unwrap();
+    destination_profile(&socket, &mut config);
+    #[cfg(target_os = "linux")]
+    capture_recovery(&socket, capture_records(&socket));
+    interrupted_controls_recover(&socket);
+    std::fs::remove_dir_all(directory).unwrap();
+}
