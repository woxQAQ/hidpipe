+/// The HID++ session is re-armed whenever the device idles; that must not take
+/// the pointer lease with it. Only the diverted controls are released.
+fn interrupted_controls_keep_the_lease(socket: &Path) {
+    let (mut capture, ack) = connect(socket, 0);
+    assert_eq!(ack, 0);
+    assert!(remote::captured("mouse", CapturedInput::Interrupted));
+    assert_eq!(
+        PointerEvent::read(&mut capture).unwrap(),
+        PointerEvent::Reset,
+        "the interrupted HID++ controls are released remotely"
+    );
+    assert!(remote::captured("mouse", CapturedInput::Ready));
+    assert!(matches!(
+        remote::hook_input(&MouseEvent::Moved {
+            delta_x: 2,
+            delta_y: -1,
+        }),
+        Some(EventDisposition::Suppress),
+        "pointer routing continues through the OS hook"
+    ));
+    assert_eq!(
+        PointerEvent::read(&mut capture).unwrap(),
+        PointerEvent::Motion { dx: 2, dy: -1 }
+    );
+    let (_, ack) = connect(socket, 0);
+    assert_eq!(ack, 1, "a HID++ re-arm must not release the pointer lease");
+}
